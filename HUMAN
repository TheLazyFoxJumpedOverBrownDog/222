from fastapi import FastAPI, Request, Form, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse, RedirectResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates
from sqlalchemy import select
from .db import database, metadata, engine, SessionLocal
from .models import users, posts, stories
from datetime import datetime, timedelta
import asyncio
import json

app = FastAPI(title='HUMAN Prototype')

app.mount('/static', StaticFiles(directory='app/static'), name='static')
templates = Jinja2Templates(directory='app/templates')

@app.on_event('startup')
async def startup():
    await database.connect()
    # create tables in engine (sync) if not exist
    metadata.create_all(engine)

@app.on_event('shutdown')
async def shutdown():
    await database.disconnect()

# Simple home -> onboarding selector
@app.get('/', response_class=HTMLResponse)
async def index(request: Request):
    query = select(users).limit(10)
    rows = await database.fetch_all(query)
    return templates.TemplateResponse('index.html', {'request': request, 'users': rows})

# Feed
@app.get('/feed/{user_id}', response_class=HTMLResponse)
async def feed(request: Request, user_id: int, mood: str = None):
    # simplistic feed: recent posts first, mood filter optional
    q = select(posts).order_by(posts.c.created_at.desc()).limit(100)
    rows = await database.fetch_all(q)
    if mood:
        rows = [r for r in rows if r['mood_tag'] == mood]
    user = await database.fetch_one(select(users).where(users.c.id == user_id))
    stories_rows = await database.fetch_all(select(stories).order_by(stories.c.created_at.desc()).limit(10))
    return templates.TemplateResponse('feed.html', {'request': request, 'posts': rows, 'user': user, 'stories': stories_rows})

# Create post (form)
@app.post('/post')
async def create_post(author_id: int = Form(...), content: str = Form(''), media_url: str = Form(''), mood_tag: str = Form('neutral')):
    query = posts.insert().values(author_id=author_id, content=content, media_url=media_url, mood_tag=mood_tag, created_at=datetime.utcnow(), realmeter=0)
    await database.execute(query)
    return RedirectResponse(url=f'/feed/{author_id}', status_code=303)

# Reactions endpoint (adjust realmeter)
@app.post('/react')
async def react(post_id: int = Form(...), kind: str = Form(...)):
    p = await database.fetch_one(select(posts).where(posts.c.id == post_id))
    if not p:
        return {'ok': False}
    delta = 1
    if kind == 'inspire': delta = 3
    elif kind == 'help': delta = 5
    new_rm = p['realmeter'] + delta
    await database.execute(posts.update().where(posts.c.id == post_id).values(realmeter=new_rm))
    return {'ok': True, 'realmeter': new_rm}

# Simple API feed JSON
@app.get('/api/feed/{user_id}')
async def api_feed(user_id: int, mood: str = None):
    q = select(posts).order_by(posts.c.created_at.desc()).limit(100)
    rows = await database.fetch_all(q)
    if mood:
        rows = [r for r in rows if r['mood_tag'] == mood]
    # convert datetimes to isoformat
    for r in rows:
        r['created_at'] = r['created_at'].isoformat()
    return rows

# --------------------
# WebSocket Chat (rooms)
# --------------------
class ConnectionManager:
    def __init__(self):
        self.active_connections: dict[str, list[WebSocket]] = {}

    async def connect(self, room: str, websocket: WebSocket):
        await websocket.accept()
        self.active_connections.setdefault(room, []).append(websocket)

    def disconnect(self, room: str, websocket: WebSocket):
        if room in self.active_connections and websocket in self.active_connections[room]:
            self.active_connections[room].remove(websocket)

    async def broadcast(self, room: str, message: dict):
        if room not in self.active_connections: return
        living = []
        for conn in self.active_connections[room]:
            try:
                await conn.send_text(json.dumps(message))
                living.append(conn)
            except:
                pass
        self.active_connections[room] = living

manager = ConnectionManager()

@app.websocket('/ws/{room}')
async def websocket_endpoint(websocket: WebSocket, room: str):
    await manager.connect(room, websocket)
    try:
        while True:
            data = await websocket.receive_text()
            try:
                msg = json.loads(data)
            except:
                msg = {'text': data}
            # broadcast to room
            await manager.broadcast(room, msg)
    except WebSocketDisconnect:
        manager.disconnect(room, websocket)
""")

