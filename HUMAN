let ws = null;
function startWS() {
  const user = document.getElementById('chatUser').value || 'anon';
  ws = new WebSocket(`ws://${location.host}/ws/general`);
  ws.onopen = () => {
    appendLog('[connected]');
    ws.send(JSON.stringify({user, text: user + ' rejoint le chat'}));
  };
  ws.onmessage = (ev) => {
    const data = JSON.parse(ev.data);
    appendLog((data.user?data.user+' : ':'') + (data.text||JSON.stringify(data)));
  };
  ws.onclose = () => appendLog('[déconnecté]');
}
function sendWS() {
  const msg = document.getElementById('chatMsg').value;
  if (!ws) { alert('Connecte le chat d’abord'); return; }
  const user = document.getElementById('chatUser').value || 'anon';
  ws.send(JSON.stringify({user, text: msg}));
  document.getElementById('chatMsg').value = '';
}
function appendLog(txt) {
  const el = document.getElementById('chatLog');
  el.innerHTML += '<div>' + txt + '</div>';
  el.scrollTop = el.scrollHeight;
}
""")

