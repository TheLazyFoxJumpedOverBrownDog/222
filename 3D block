<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Interactive 3D Blocks</title>
  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
  <style>
    body { margin: 0; }
    button {
      position: fixed;
      top: 10px;
      left: 10px;
      padding: 10px 15px;
      z-index: 999;
      font-size: 16px;
      background-color: #4CAF50;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
  </style>
</head>
<body>

<button onclick="addBlock()">नया Block जोड़ो</button>

<a-scene>
  <!-- Camera -->
  <a-entity position="0 1.6 3">
    <a-camera></a-camera>
  </a-entity>

  <!-- Ground -->
  <a-plane position="0 0 -5" rotation="-90 0 0" width="20" height="20" color="#7BC8A4"></a-plane>
</a-scene>

<script>
  function addBlock() {
    const scene = document.querySelector("a-scene");
    const box = document.createElement("a-box");

    // Random position and color
    box.setAttribute("position", `${Math.random()*4-2} 1.5 ${-Math.random()*5}`);
    box.setAttribute("color", `hsl(${Math.random()*360}, 70%, 50%)`);
    box.setAttribute("depth", "1");
    box.setAttribute("height", "1");
    box.setAttribute("width", "1");

    // Add simple rotation animation
    box.setAttribute("animation", "property: rotation; to: 0 360 0; loop: true; dur: 4000; easing: linear;");

    scene.appendChild(box);
  }
</script>

</body>
</html>
