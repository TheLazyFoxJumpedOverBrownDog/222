    <main className="grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* Capture Card */}
      <section className="bg-white shadow-sm rounded-lg p-4">
        <div className="flex items-center justify-between mb-4">
          <h2 className="font-semibold">Capture & Metadata</h2>
          <div className="text-xs text-slate-500">Step 1 • Field</div>
        </div>

        <div className="space-y-3">
          <div>
            <label className="block text-xs font-medium text-slate-700 mb-1">Mode Sampling</label>
            <div className="flex gap-2">
              <button
                onClick={() => setMode("chew-pad")}
                className={`px-3 py-1 rounded ${mode === "chew-pad" ? "bg-blue-600 text-white" : "bg-slate-100"}`}>
                Chew-pad
              </button>
              <button
                onClick={() => setMode("rub-sample")}
                className={`px-3 py-1 rounded ${mode === "rub-sample" ? "bg-blue-600 text-white" : "bg-slate-100"}`}>
                Rub-sampling
              </button>
            </div>
          </div>

          <div>
            <label className="block text-xs font-medium text-slate-700 mb-1">Foto Strip / Chew-pad</label>
            <div className="border border-dashed border-slate-200 rounded p-3 flex flex-col items-center">
              {photo ? (
                <img src={photo} alt="preview" className="h-36 object-contain" />
              ) : (
                <div className="text-sm text-slate-500 mb-2">No image captured</div>
              )}
              <div className="flex gap-2 mt-3">
                <input ref={fileInputRef} type="file" accept="image/*" onChange={handlePickFile} className="hidden" />
                <button onClick={handleCaptureClick} className="px-3 py-1 rounded bg-emerald-600 text-white text-sm">Ambil Foto</button>
                <button onClick={() => setPhoto(null)} className="px-3 py-1 rounded bg-slate-100 text-sm">Hapus</button>
              </div>
            </div>
          </div>

          <div>
            <label className="block text-xs font-medium text-slate-700 mb-1">Lokasi (GPS / Deskripsi)</label>
            <input value={location} onChange={(e) => setLocation(e.target.value)} className="w-full rounded border px-2 py-1 text-sm" placeholder="Contoh: Desa X, RT 03" />
          </div>

          <div>
            <label className="block text-xs font-medium text-slate-700 mb-1">Catatan/Observasi</label>
            <textarea value={notes} onChange={(e) => setNotes(e.target.value)} className="w-full rounded border px-2 py-1 text-sm" rows={3} placeholder="Perilaku: agresif / hipersalivasi / lain-lain"></textarea>
          </div>

          <div className="flex items-center gap-2 justify-between">
            <div className="text-sm text-slate-500">Status koneksi: offline (demo)</div>
            <div className="flex gap-2">
              <button onClick={handleSaveSample} disabled={uploading} className="px-3 py-1 bg-blue-600 text-white rounded text-sm">Simpan Sampel</button>
              <button onClick={handleSyncAll} disabled={uploading} className="px-3 py-1 bg-slate-100 rounded text-sm">Sinkronisasi (mock)</button>
            </div>
          </div>
        </div>
      </section>

      {/* Samples List / Dashboard */}
      <section className="bg-white shadow-sm rounded-lg p-4">
        <div className="flex items-center justify-between mb-4">
          <h2 className="font-semibold">Daftar Sampel Tersimpan</h2>
          <div className="text-xs text-slate-500">Total: {samples.length}</div>
        </div>

        <div className="space-y-3 max-h-[56vh] overflow-auto">
          {samples.length === 0 ? (
            <div className="text-sm text-slate-500">Belum ada sampel. Simpan sampel dari sisi kiri.</div>
          ) : (
            samples.map((s) => (
              <article key={s.id} className="border rounded p-3 flex gap-3">
                <img src={s.photo} alt="thumb" className="h-20 w-20 object-cover rounded" />
                <div className="flex-1">
                  <div className="flex items-center justify-between">
                    <div>
                      <div className="font-medium">{s.mode === "chew-pad" ? "Chew-pad" : "Rub-sampling"}</div>
                      <div className="text-xs text-slate-500">{new Date(s.createdAt).toLocaleString()}</div>
                    </div>
                    <div className="text-right">
                      <div className="text-sm">{s.inference.label}</div>
                      <div className="text-xs text-slate-400">score: {s.inference.score}</div>
                    </div>
                  </div>

                  <p className="text-sm text-slate-600 mt-1">{s.notes || "-"}</p>
                  <div className="flex gap-2 mt-2 items-center">
                    <button onClick={() => handleMarkSynced(s.id)} className="text-xs px-2 py-1 bg-emerald-100 rounded">Mark Synced</button>
                    <button onClick={() => handleDelete(s.id)} className="text-xs px-2 py-1 bg-rose-100 rounded">Hapus</button>
                  </div>
                </div>
              </article>
            ))
          )}
        </div>

        <div className="mt-4 text-xs text-slate-500">Catatan: prototipe ini mensimulasikan inference secara lokal untuk demo. Integrasi AI/Server diperlukan untuk validasi dan production.</div>
      </section>
    </main>

    <footer className="mt-6 text-sm text-slate-500">Prototype UI • RAISE-RAB — untuk proposal & demo lapangan. Developed as a mockup only.</footer>
  </div>
</div>



);
}

