import React, { useState, useRef, useEffect } from "react";


// RAISE-RAB Prototype React Component
// - Tailwind classes used for styling
// - Simulates: capture photo (strip or chew-pad), add metadata, store locally, preview results
// - Offline-first friendly: saves to localStorage queue
// - Notes: This is a front-end prototype for demo and mockup purposes only.


export default function RaiseRabPrototype() {
const [samples, setSamples] = useState(() => {
try {
return JSON.parse(localStorage.getItem("raise_samples_v1")) || [];
} catch (e) {
return [];
}
});


const [photo, setPhoto] = useState(null);
const [mode, setMode] = useState("chew-pad");
const [notes, setNotes] = useState("");
const [location, setLocation] = useState("");
const [uploading, setUploading] = useState(false);
const fileInputRef = useRef(null);


useEffect(() => {
localStorage.setItem("raise_samples_v1", JSON.stringify(samples));
}, [samples]);


// Simple helper: simulate inference for demo (colorimetric/AI placeholder)
function simulateInference(imgData) {
// Very naive simulation: random with bias based on mode
const rand = Math.random();
const score = rand;
const label = score > 0.85 ? "High risk" : score > 0.5 ? "Suspect" : "Negative";
return { label, score: Number(score.toFixed(2)) };
}


function handlePickFile(e) {
const f = e.target.files?.[0];
if (!f) return;
const reader = new FileReader();
reader.onload = (ev) => setPhoto(ev.target.result);
reader.readAsDataURL(f);
}


function handleCaptureClick() {
fileInputRef.current?.click();
}


async function handleSaveSample() {
if (!photo) return alert("Please attach a photo of the strip / chew-pad first");
setUploading(true);
// Simulate inference + local save
const inference = simulateInference(photo);
const newSample = {
id: Date.now().toString(),
mode,
notes,
location,
photo,
inference,
status: "queued",
createdAt: new Date().toISOString(),
};


setSamples((s) => [newSample, ...s]);
setPhoto(null);
setNotes("");
setLocation("");
setUploading(false);



}


function handleDelete(id) {
if (!confirm("Hapus sampel ini?")) return;
setSamples((s) => s.filter((x) => x.id !== id));
}


function handleMarkSynced(id) {
setSamples((s) =>
s.map((x) => (x.id === id ? { ...x, status: "synced" } : x))
);
}


// Simple offline sync button (mock)
async function handleSyncAll() {
setUploading(true);
// simulate network delay
await new Promise((r) => setTimeout(r, 1000));
setSamples((s) => s.map((x) => ({ ...x, status: "synced" })));
setUploading(false);
alert("Semua sampel telah disinkronkan (mock)");
}


return (






