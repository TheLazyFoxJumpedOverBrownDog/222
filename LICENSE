<body>
  <header>
    <h1>🚀 Rocketry Flashcards</h1>
    <div id="score">Score: 0</div>
  </header>
  <!-- Start button controls -->
  <div class="controls" id="startControls">
    <button id="startBtn">Start</button>
  </div>

  <!-- Flashcard -->
  <div class="card" id="card">
    <div class="inner">
      <div class="side front" id="front"></div>
      <div class="side back" id="back"></div>
    </div>
  </div>

  <!-- Game controls -->
  <div class="controls game-controls" id="gameControls">
    <button class="btn-correct" id="correctBtn">I knew it</button>
    <button class="btn-wrong" id="wrongBtn">I didn’t</button>
    <button class="btn-next" id="nextBtn">Next</button>
  </div>

  <script>
    const CARD_DATA = [
      ["Who proposed the rocket equation linking exhaust velocity and mass ratio?", "Konstantin Tsiolkovsky"],
      ["Who launched the first liquid-fueled rocket in 1926?", "Robert Goddard"],
      ["Which scientist wrote 'The Rocket into Planetary Space'?", "Hermann Oberth"],
      ["Which WWII-era rocket was the first long-range guided ballistic missile?", "V-2 rocket"],
      ["Who led the V-2 rocket program in Germany?", "Wernher von Braun"],
      ["What was Skylab launched by?", "A Saturn V (final flight)"],
      ["What property does exhaust velocity (ve) affect in the rocket equation?", "Delta-v (change in velocity) capability"],
      ["What is the simplest 'two-body' orbital parameter often used to describe orbit size?", "Semi-major axis"],
      ["Which Soviet designer led early Soviet rocket development?", "Sergey Korolev"],
      ["What was GIRD-09?", "An early Soviet liquid-fuel rocket (1933)"],
      ["Which Soviet rocket family grew from the R-7 design?", "Soyuz family"],
      ["Why use staging in rockets?", "Staging sheds dead mass to increase efficiency and achievable delta-v"],
      ["What is thrust-to-weight ratio (T/W)?", "Thrust divided by weight; measures initial acceleration capability"],
      ["What is payload fraction?", "Portion of total liftoff mass that is useful payload"],
      ["Name a guidance method used on early rockets.", "Gyroscopic guidance / movable engine gimbaling"],
      ["What is a launch window?", "The time interval when launch conditions allow reaching the desired orbit or target"],
      ["Why was the V-2 historically important beyond its weapon role?", "It proved large liquid-fueled rockets and advanced guidance/propulsion"],
      ["What does 'delta-v' represent?", "Total change in velocity a vehicle can achieve"],
      ["What is atmospheric drag's effect on rockets during ascent?", "Reduces efficiency and requires additional thrust/fuel"],
      ["Why are upper-stage engines often restarted in space?", "To perform multiple burns: circularize orbit, transfer, or injection"],
      ["What is an inertial navigation system (INS)?", "A guidance system using accelerometers and gyros to compute position/velocity"],
      ["Name one modern launch requirement improved since early rockets.", "Reusability, precision guidance, higher reliability, or payload capacity"],
      ["What was a simple home 'model' rocket example mentioned in the packet?", "Matchstick/match-paper rocket or sugar/oxidizer solid rockets (DIY demonstration)"],
      ["Why are liquid fuels favored for high-performance rockets?", "Higher specific impulse and throttle/control capability"],
      ["Which mission first broadcast live televised images of Earth from lunar distance?", "Apollo 8"]
    ];
    let index = 0;
    let score = 0;
    const frontEl = document.getElementById('front');
    const backEl = document.getElementById('back');
    const cardEl = document.getElementById('card');
    const scoreEl = document.getElementById('score');

    const startBtn = document.getElementById('startBtn');
    const startControls = document.getElementById('startControls');
    const gameControls = document.getElementById('gameControls');

    function showCard() {
      const [q, a] = CARD_DATA[index];
      frontEl.textContent = q;
      backEl.textContent = a;
      cardEl.classList.remove('flipped');
    }

    function startGame() {
      index = 0;
      score = 0;
      scoreEl.textContent = "Score: 0";
      showCard();
      cardEl.style.display = "flex"; // show card
      gameControls.style.display = "flex"; // show controls
      startControls.style.display = "none"; // hide start button
    }

    cardEl.addEventListener('click', () => {
      cardEl.classList.toggle('flipped');
    });

    document.getElementById('correctBtn').addEventListener('click', () => {
      score++;
      scoreEl.textContent = `Score: ${score}`;
    });

    document.getElementById('wrongBtn').addEventListener('click', () => {
      scoreEl.textContent = `Score: ${score}`;
    });

    document.getElementById('nextBtn').addEventListener('click', () => {
      index = (index + 1) % CARD_DATA.length;
      showCard();
    });

    startBtn.addEventListener('click', startGame);
  </script>
</body>
</html>
