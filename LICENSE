  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rocketry Flashcards</title>
  <style>
    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: #121212;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }
    header {
      width: 100%;
      max-width: 800px;
      padding: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    h1 { font-size: 1.2rem; margin: 0; }
    .card {
      background: #1e1e1e;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.6);
      width: 90%;
      max-width: 600px;
      min-height: 200px;
      display: none; /* hidden until Start */
      align-items: center;
      justify-content: center;
      padding: 2rem;
      text-align: center;
      font-size: 1.4rem;
      cursor: pointer;
      transition: transform 0.6s;
      perspective: 1000px;
      margin-top: 1rem;
      position: relative;
    }
    .inner { width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 0.6s; }
    .flipped .inner { transform: rotateY(180deg); }
    .side {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      padding: 1rem; backface-visibility: hidden; border-radius: 12px;
    }
    .front { background: transparent; }
    .back { background: transparent; transform: rotateY(180deg); }
    .controls { margin-top: 1rem; display: flex; gap: 0.5rem; }
    .game-controls { display: none; } /* hidden until Start */
    button {
      padding: 0.6rem 1rem; border: none; border-radius: 8px;
      cursor: pointer; font-size: 1rem;
    }
    .btn-correct { background: #29d37a; color: #000; }
    .btn-wrong { background: #ff6b6b; color: #fff; }
    .btn-next { background: #444; color: #fff; }
  </style>
