// --- Main App --- export default function App() { const [view, setView] = useState("home"); // home, shop, about, contact, reviews const [cart, setCart] = useState(() => { try { const raw = localStorage.getItem("noor_cart_v1"); return raw ? JSON.parse(raw) : []; } catch (e) { return []; } }); const [products] = useState(PRODUCTS); const [query, setQuery] = useState(""); const [checkoutOpen, setCheckoutOpen] = useState(false); const [orderPlaced, setOrderPlaced] = useState(null);

useEffect(() => { localStorage.setItem("noor_cart_v1", JSON.stringify(cart)); }, [cart]);

function addToCart(prod) { setCart((c) => { const found = c.find((x) => x.id === prod.id); if (found) return c.map((x) => (x.id === prod.id ? { ...x, qty: x.qty + 1 } : x)); return [...c, { ...prod, qty: 1 }]; }); }

function updateQty(id, qty) { setCart((c) => c.map((x) => (x.id === id ? { ...x, qty: Math.max(0, qty) } : x)).filter((x) => x.qty > 0)); }

function removeFromCart(id) { setCart((c) => c.filter((x) => x.id !== id)); }

function clearCart() { setCart([]); }

const subtotal = cart.reduce((s, p) => s + p.price * p.qty, 0); const shipping = subtotal > 0 ? 5.0 : 0.0; const total = subtotal + shipping;

function placeOrder(details) { // Demo order placement: create a simple order object and 'place' it. const order = { id: ORD-${Date.now()}, items: cart, total, details, date: new Date().toISOString(), }; setOrderPlaced(order); clearCart(); setCheckoutOpen(false); }

// simple filtered products const visibleProducts = products.filter((p) => p.name.toLowerCase().includes(query.toLowerCase()) || p.desc.toLowerCase().includes(query.toLowerCase()));

return ( 

