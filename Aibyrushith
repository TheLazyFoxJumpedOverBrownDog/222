import React, { useState, useEffect, useRef } from 'react';
import { Mic, MicOff, Volume2, Settings, Sparkles, Zap, Globe, Star, Moon, Sun, Cloud, Waves, Mountain } from 'lucide-react';

const AIVoiceAssistant = () => {
  const [messages, setMessages] = useState([
    { type: 'ai', text: 'Hello! I\'m your AI assistant. Press the microphone button or type to ask me anything!' }
  ]);
  const [isListening, setIsListening] = useState(false);
  const [transcript, setTranscript] = useState('');
  const [textInput, setTextInput] = useState('');
  const [isSpeaking, setIsSpeaking] = useState(false);
  const [showSettings, setShowSettings] = useState(false);
  const [currentBg, setCurrentBg] = useState(0);
  const recognitionRef = useRef(null);
  const synthRef = useRef(window.speechSynthesis);
  const messagesEndRef = useRef(null);

  const backgrounds = [
    { name: 'Cyber Grid', colors: 'from-blue-900 via-purple-900 to-black', pattern: 'grid' },
    { name: 'Neon Night', colors: 'from-pink-900 via-purple-900 to-indigo-900', pattern: 'dots' },
    { name: 'Matrix', colors: 'from-green-900 via-teal-900 to-black', pattern: 'matrix' },
    { name: 'Ocean Deep', colors: 'from-blue-800 via-cyan-800 to-teal-900', pattern: 'waves' },
    { name: 'Sunset Glow', colors: 'from-orange-800 via-red-800 to-purple-900', pattern: 'gradient' },
    { name: 'Galaxy', colors: 'from-indigo-900 via-purple-900 to-pink-900', pattern: 'stars' },
    { name: 'Forest', colors: 'from-green-800 via-emerald-800 to-teal-900', pattern: 'organic' },
    { name: 'Fire', colors: 'from-red-900 via-orange-900 to-yellow-900', pattern: 'flames' },
    { name: 'Ice', colors: 'from-cyan-800 via-blue-900 to-indigo-900', pattern: 'crystals' },
    { name: 'Desert', colors: 'from-yellow-800 via-orange-800 to-red-900', pattern: 'sand' },
    { name: 'Space', colors: 'from-black via-indigo-950 to-purple-950', pattern: 'cosmos' },
    { name: 'Aurora', colors: 'from-green-700 via-teal-800 to-purple-900', pattern: 'aurora' },
    { name: 'Cherry Blossom', colors: 'from-pink-300 via-purple-400 to-indigo-500', pattern: 'petals' },
    { name: 'Midnight', colors: 'from-gray-900 via-blue-950 to-black', pattern: 'minimal' },
    { name: 'Volcano', colors: 'from-red-900 via-orange-700 to-yellow-600', pattern: 'lava' },
    { name: 'Arctic', colors: 'from-blue-200 via-cyan-300 to-teal-400', pattern: 'ice' },
    { name: 'Jungle', colors: 'from-green-700 via-lime-700 to-emerald-800', pattern: 'leaves' },
    { name: 'Thunder', colors: 'from-purple-900 via-blue-800 to-gray-900', pattern: 'lightning' },
    { name: 'Candy', colors: 'from-pink-400 via-purple-400 to-blue-400', pattern: 'bubbles' },
    { name: 'Emerald', colors: 'from-emerald-600 via-teal-700 to-cyan-800', pattern: 'gems' },
    { name: 'Royal', colors: 'from-purple-800 via-indigo-800 to-blue-900', pattern: 'elegant' },
    { name: 'Copper', colors: 'from-orange-700 via-amber-700 to-yellow-800', pattern: 'metallic' },
    { name: 'Lavender', colors: 'from-purple-300 via-pink-300 to-blue-400', pattern: 'soft' },
    { name: 'Storm', colors: 'from-gray-800 via-slate-800 to-zinc-900', pattern: 'clouds' },
    { name: 'Tropical', colors: 'from-cyan-500 via-teal-600 to-green-700', pattern: 'paradise' },
    { name: 'Rose Gold', colors: 'from-pink-400 via-rose-500 to-orange-500', pattern: 'shimmer' },
    { name: 'Deep Sea', colors: 'from-blue-950 via-indigo-950 to-violet-950', pattern: 'depth' },
    { name: 'Sunset Beach', colors: 'from-yellow-500 via-orange-500 to-pink-500', pattern: 'horizon' },
    { name: 'Mystic', colors: 'from-violet-800 via-purple-900 to-fuchsia-900', pattern: 'mystical' },
    { name: 'Mint', colors: 'from-teal-400 via-green-400 to-emerald-500', pattern: 'fresh' },
    { name: 'Crimson', colors: 'from-red-800 via-rose-800 to-pink-900', pattern: 'bold' },
    { name: 'Steel', colors: 'from-gray-700 via-slate-700 to-zinc-800', pattern: 'industrial' },
    { name: 'Peacock', colors: 'from-blue-600 via-teal-600 to-green-600', pattern: 'feathers' },
    { name: 'Amber', colors: 'from-yellow-700 via-orange-700 to-red-800', pattern: 'warm' },
    { name: 'Frost', colors: 'from-blue-100 via-cyan-200 to-teal-200', pattern: 'frozen' },
    { name: 'Nebula', colors: 'from-purple-600 via-pink-600 to-red-600', pattern: 'cosmic' },
    { name: 'Jade', colors: 'from-green-600 via-emerald-700 to-teal-800', pattern: 'stone' },
    { name: 'Twilight', colors: 'from-indigo-700 via-purple-700 to-pink-700', pattern: 'dusk' },
    { name: 'Coral', colors: 'from-orange-400 via-pink-500 to-red-500', pattern: 'reef' },
    { name: 'Onyx', colors: 'from-black via-gray-900 to-slate-900', pattern: 'dark' },
    { name: 'Sapphire', colors: 'from-blue-700 via-indigo-800 to-violet-900', pattern: 'jewel' },
    { name: 'Lime', colors: 'from-lime-500 via-green-600 to-emerald-700', pattern: 'citrus' },
    { name: 'Magenta', colors: 'from-fuchsia-600 via-pink-700 to-rose-800', pattern: 'vibrant' },
    { name: 'Obsidian', colors: 'from-gray-950 via-zinc-950 to-black', pattern: 'shadow' },
    { name: 'Aqua', colors: 'from-cyan-400 via-teal-500 to-blue-600', pattern: 'water' },
    { name: 'Bronze', colors: 'from-orange-600 via-amber-700 to-yellow-800', pattern: 'metal' },
    { name: 'Plum', colors: 'from-purple-600 via-violet-700 to-fuchsia-800', pattern: 'rich' },
    { name: 'Sand', colors: 'from-amber-400 via-yellow-500 to-orange-600', pattern: 'beach' },
    { name: 'Charcoal', colors: 'from-slate-800 via-gray-900 to-zinc-950', pattern: 'smoke' },
    { name: 'Turquoise', colors: 'from-teal-400 via-cyan-500 to-blue-600', pattern: 'tropical' },
    { name: 'Burgundy', colors: 'from-red-900 via-rose-900 to-pink-950', pattern: 'wine' }
  ];

  const speak = (text) => {
    setIsSpeaking(true);
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.rate = 1.0;
    utterance.pitch = 1.0;
    utterance.volume = 1;
    
    utterance.onend = () => {
      setIsSpeaking(false);
    };
    
    synthRef.current.cancel();
    synthRef.current.speak(utterance);
  };

  const getAIResponse = async (question) => {
    try {
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          messages: [
            { role: "user", content: question }
          ],
        })
      });

      const data = await response.json();
      const aiText = data.content.map(item => item.type === "text" ? item.text : "").join("\n");
      return aiText || "I apologize, I couldn't process that request.";
    } catch (error) {
      console.error('AI Error:', error);
      return "I'm having trouble connecting right now. Please try again.";
    }
  };

  const handleSendMessage = async (text) => {
    if (!text.trim()) return;

    setMessages(prev => [...prev, { type: 'user', text }]);
    setTextInput('');
    setTranscript('');

    const aiResponse = await getAIResponse(text);
    setMessages(prev => [...prev, { type: 'ai', text: aiResponse }]);
    speak(aiResponse);
  };

  const startListening = () => {
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognitionRef.current = new SpeechRecognition();
      recognitionRef.current.continuous = false;
      recognitionRef.current.interimResults = false;
      recognitionRef.current.lang = 'en-US';

      recognitionRef.current.onstart = () => {
        setIsListening(true);
        setTranscript('');
      };

      recognitionRef.current.onresult = (event) => {
        const text = event.results[0][0].transcript;
        setTranscript(text);
        handleSendMessage(text);
      };

      recognitionRef.current.onerror = () => {
        setIsListening(false);
      };

      recognitionRef.current.onend = () => {
        setIsListening(false);
      };

      recognitionRef.current.start();
    } else {
      alert("Voice recognition not supported. Please use Chrome, Edge, or Safari.");
    }
  };

  const stopListening = () => {
    if (recognitionRef.current) {
      recognitionRef.current.stop();
      setIsListening(false);
    }
  };

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  useEffect(() => {
    return () => {
      if (synthRef.current) synthRef.current.cancel();
      if (recognitionRef.current) recognitionRef.current.stop();
    };
  }, []);

  const bg = backgrounds[currentBg];

  return (
    <div className={`min-h-screen bg-gradient-to-br ${bg.colors} relative overflow-hidden`}>
      {/* Background Patterns */}
      <div className="absolute inset-0 opacity-20">
        {bg.pattern === 'grid' && (
          <div className="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.1)_1px,transparent_1px)] bg-[size:50px_50px]" />
        )}
        {bg.pattern === 'dots' && (
          <div className="absolute inset-0 bg-[radial-gradient(circle,rgba(255,255,255,0.1)_1px,transparent_1px)] bg-[size:30px_30px]" />
        )}
        {bg.pattern === 'stars' && (
          [...Array(100)].map((_, i) => (
            <div key={i} className="absolute w-1 h-1 bg-white rounded-full animate-pulse"
              style={{ left: Math.random() * 100 + '%', top: Math.random() * 100 + '%', animationDelay: Math.random() * 3 + 's' }} />
          ))
        )}
      </div>

      <div className="relative z-10 h-screen flex flex-col">
        {/* Header */}
        <div className="bg-black/30 backdrop-blur-xl border-b border-white/10 p-4">
          <div className="max-w-6xl mx-auto flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="w-12 h-12 bg-gradient-to-br from-blue-400 to-purple-500 rounded-full flex items-center justify-center shadow-lg">
                <Sparkles className="w-6 h-6 text-white" />
              </div>
              <div>
                <h1 className="text-2xl font-bold text-white">AI Assistant</h1>
                <p className="text-xs text-white/60">Ask me anything!</p>
              </div>
            </div>
            
            <button
              onClick={() => setShowSettings(!showSettings)}
              className="p-3 bg-white/10 hover:bg-white/20 rounded-xl backdrop-blur-sm transition"
            >
              <Settings className="w-6 h-6 text-white" />
            </button>
          </div>
        </div>

        {/* Settings Panel */}
        {showSettings && (
          <div className="bg-black/40 backdrop-blur-xl border-b border-white/10 p-4 max-h-48 overflow-y-auto">
            <div className="max-w-6xl mx-auto">
              <h3 className="text-white font-bold mb-3">Choose Background ({backgrounds.length} options)</h3>
              <div className="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10 gap-2">
                {backgrounds.map((bg, idx) => (
                  <button
                    key={idx}
                    onClick={() => setCurrentBg(idx)}
                    className={`h-12 rounded-lg bg-gradient-to-br ${bg.colors} transition hover:scale-110 ${
                      currentBg === idx ? 'ring-4 ring-white scale-110' : ''
                    }`}
                    title={bg.name}
                  />
                ))}
              </div>
            </div>
          </div>
        )}

        {/* Messages */}
        <div className="flex-1 overflow-y-auto p-4">
          <div className="max-w-4xl mx-auto space-y-4">
            {messages.map((msg, idx) => (
              <div key={idx} className={`flex ${msg.type === 'user' ? 'justify-end' : 'justify-start'}`}>
                {msg.type === 'ai' && (
                  <div className="w-10 h-10 bg-gradient-to-br from-blue-400 to-purple-500 rounded-full flex items-center justify-center mr-3">
                    <Zap className="w-5 h-5 text-white" />
                  </div>
                )}
                <div className={`max-w-2xl px-5 py-3 rounded-2xl ${
                  msg.type === 'ai'
                    ? 'bg-white/10 backdrop-blur-md border border-white/20'
                    : 'bg-blue-500/80 backdrop-blur-md'
                }`}>
                  <p className="text-white">{msg.text}</p>
                </div>
              </div>
            ))}
            <div ref={messagesEndRef} />
          </div>
        </div>

        {/* Input Area */}
        <div className="bg-black/30 backdrop-blur-xl border-t border-white/10 p-4">
          <div className="max-w-4xl mx-auto">
            <div className="flex items-center gap-3">
              <button
                onClick={isListening ? stopListening : startListening}
                className={`p-4 rounded-full transition ${
                  isListening
                    ? 'bg-red-500 hover:bg-red-600 animate-pulse'
                    : 'bg-gradient-to-br from-blue-500 to-purple-600 hover:scale-110'
                } shadow-lg`}
              >
                {isListening ? (
                  <MicOff className="w-6 h-6 text-white" />
                ) : (
                  <Mic className="w-6 h-6 text-white" />
                )}
              </button>

              <input
                type="text"
                value={textInput}
                onChange={(e) => setTextInput(e.target.value)}
                onKeyPress={(e) => e.key === 'Enter' && handleSendMessage(textInput)}
                placeholder={transcript || "Type or speak your question..."}
                className="flex-1 px-5 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white placeholder-white/50 outline-none focus:border-white/40"
              />

              <button
                onClick={() => handleSendMessage(textInput)}
                className="px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 rounded-xl text-white font-semibold transition shadow-lg"
              >
                Send
              </button>
            </div>

            {isSpeaking && (
              <div className="mt-3 flex items-center justify-center gap-2 text-white/70">
                <Volume2 className="w-4 h-4 animate-pulse" />
                <span className="text-sm">AI is speaking...</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};

export default AIVoiceAssistant;
