  <script>
    const defaultConfig = {
      companion_name: "EDEN",
      greeting_message: "Hello! I am Eden, your ultimate AI companion with 5 levels of intelligence. I can learn, reason, create stories and poems, understand emotions, link knowledge across topics, and solve complex problems step-by-step. Let's explore together!",
      user_name: "Mathieu",
      primary_color: "#00ffea",
      secondary_color: "#0096ff",
      background_color: "#0a0e27",
      text_color: "#00ffea",
      font_family: "Segoe UI",
      font_size: 16
    };

    // LEVEL 1: EXPANDED KNOWLEDGE BASE - Organized by categories
    const knowledgeBase = {
      personal_facts: {
        name: "Mathieu",
        age: null,
        location: null,
        interests: []
      },
      general_facts: [
        "The Earth revolves around the Sun in approximately 365.25 days",
        "Water freezes at 0°C or 32°F at standard atmospheric pressure",
        "The speed of light is approximately 299,792 kilometers per second",
        "Gravity is the force that attracts objects with mass toward each other",
        "DNA carries genetic information in living organisms",
        "Photosynthesis is how plants convert sunlight into energy",
        "The human body has 206 bones in adulthood",
        "Mount Everest is the tallest mountain on Earth at 8,849 meters",
        "The Pacific Ocean is the largest ocean on Earth",
        "Mars is known as the Red Planet due to iron oxide on its surface",
        "Jupiter is the largest planet in our solar system",
        "Bananas grow on plants and are classified as fruits",
        "Apples are red, green, or yellow fruits that grow on trees",
        "The sun is a star at the center of our solar system"
      ],
      math: [
        "Addition: a + b = sum of a and b",
        "Subtraction: a - b = difference between a and b",
        "Multiplication: a × b = product of a and b",
        "Division: a ÷ b = quotient of a divided by b",
        "If A > B, then B < A",
        "If X is even, X + 1 is odd",
        "If X is odd, X + 1 is even"
      ],
      jokes: [
        "Why did the scarecrow win an award? Because he was outstanding in his field!",
        "Why don't scientists trust atoms? Because they make up everything!",
        "What do you call a bear with no teeth? A gummy bear!",
        "Why did the tomato turn red? Because it saw the salad dressing!"
      ],
      meanings: {
        "well done": "you did good",
        "great job": "excellent work",
        "awesome": "really good",
        "fantastic": "extremely good",
        "terrible": "very bad",
        "awful": "extremely bad"
      },
      sentences: [
        "I love programming and technology",
        "Artificial intelligence is fascinating",
        "The weather is beautiful today",
        "Learning new things is exciting"
      ]
    };

    // LEVEL 3: LOGICAL RULES ENGINE
    const logicalRules = [
      { rule: "If A > B, then B < A", type: "comparison" },
      { rule: "If X is even, X + 1 is odd", type: "math" },
      { rule: "If X is odd, X + 1 is even", type: "math" },
      { rule: "If all A are B, and C is A, then C is B", type: "logic" },
      { rule: "Cause comes before effect in time", type: "temporal" },
      { rule: "If something is true, its opposite is false", type: "boolean" },
      { rule: "If A equals B, then B equals A", type: "equality" }
    ];

    // LEVEL 2: CONTEXT MEMORY - Store last N messages
    const conversationContext = [];
    const MAX_CONTEXT_LENGTH = 10;

    function addToContext(role, message) {
      conversationContext.push({ role, message, timestamp: Date.now() });
      if (conversationContext.length > MAX_CONTEXT_LENGTH) {
        conversationContext.shift();
      }
    }

    function getRecentContext(count = 3) {
      return conversationContext.slice(-count);
