    async function processTrainingData(text) {
      if (!text.trim()) {
        return { success: false, message: 'No training data provided' };
      }

      const lines = text.split(/\n+/).filter(line => line.trim().length > 0);
      let phrasesLearned = 0;
      let wordsLearned = 0;
      let sentencesLearned = 0;
      let qaPairsLearned = 0;
      let mathProblemsLearned = 0;
      const newWords = new Set();

      for (const line of lines) {
        const trimmedLine = line.trim();
        if (trimmedLine.length < 3) continue;

        // Check for math problems (e.g., "5 + 3 = 8" or "What is 10 * 2. 20")
        const mathPattern = /(\d+)\s*([\+\-\*\/×÷])\s*(\d+)\s*(?:=|equals|is)?\s*(\d+)/i;
        const mathMatch = trimmedLine.match(mathPattern);
        
        if (mathMatch) {
          const num1 = parseInt(mathMatch[1]);
          const operator = mathMatch[2];
          const num2 = parseInt(mathMatch[3]);
          const answer = parseInt(mathMatch[4]);
          
          if (memoryData.length >= 999) {
            return { success: false, message: 'Memory capacity reached at 999 items' };
          }

          const question = `what is ${num1} ${operator} ${num2}`;
          const qaKey = `qa_math_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;
          const success = await storeMemory('qa_pair', qaKey, JSON.stringify({ 
            question: question, 
            answer: `${num1} ${operator} ${num2} equals ${answer}` 
          }));
          
          if (success) {
            questionAnswerPairs.push({ 
              question: question, 
              answer: `${num1} ${operator} ${num2} equals ${answer}` 
            });
            mathProblemsLearned++;
          }
          continue;
        }

        // Split by period to separate question from answer
        const parts = trimmedLine.split(/\.\s+/);
        
        if (parts.length >= 2) {
          const firstPart = parts[0].trim().toLowerCase();
          const restParts = parts.slice(1).join('. ').trim();
          
          // Check if this is a question-answer pair (first part is a question/trigger)
          const questionPatterns = [
            /^(tell me|what|why|how|when|where|who|can you|do you|should|would|could)/i,
            /\?$/
          ];
          
          const isQuestion = questionPatterns.some(pattern => pattern.test(firstPart));
          
          if (isQuestion && restParts.length > 0) {
            // This is a question-answer pair
            if (memoryData.length >= 999) {
              return { success: false, message: 'Memory capacity reached at 999 items' };
            }

            const qaKey = `qa_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;
            const success = await storeMemory('qa_pair', qaKey, JSON.stringify({ question: firstPart, answer: restParts }));
            if (success) {
              questionAnswerPairs.push({ question: firstPart, answer: restParts });
              qaPairsLearned++;
            }
            
            // Still extract words from both question and answer
            const allWords = (firstPart + ' ' + restParts).toLowerCase().split(/\s+/);
            for (const word of allWords) {
              const cleanWord = word.replace(/[^a-z0-9]/gi, '');
              if (cleanWord.length > 2 && !learnedWords.has(cleanWord)) {
                learnedWords.add(cleanWord);
                newWords.add(cleanWord);
              }
            }
            continue;
          }
        }

        // Learn phrase meanings (e.g., "well done means you did good")
        const meansPattern = /(.+?)\s+means?\s+(.+)/i;
        const match = trimmedLine.match(meansPattern);

        if (match) {
          const phrase = match[1].trim().toLowerCase();
          const meaning = match[2].trim();
          
          if (memoryData.length >= 999) {
            return { success: false, message: 'Memory capacity reached at 999 items' };
          }

          const success = await storeMemory('phrase', phrase, meaning);
          if (success) {
            learnedPhrases.push({ phrase, meaning });
            phrasesLearned++;
          }
        } else {
          // Learn entire sentence as context
          if (memoryData.length >= 999) {
            return { success: false, message: 'Memory capacity reached at 999 items' };
          }

          const sentenceKey = `sentence_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;
          const success = await storeMemory('sentence', sentenceKey, trimmedLine);
          if (success) {
            learnedSentences.push(trimmedLine.toLowerCase());
            sentencesLearned++;
          }
        }

        // Extract and learn every word from the sentence
        const words = trimmedLine.toLowerCase().split(/\s+/);
        for (const word of words) {
          const cleanWord = word.replace(/[^a-z0-9]/gi, '');
          if (cleanWord.length > 2 && !learnedWords.has(cleanWord)) {
            learnedWords.add(cleanWord);
            newWords.add(cleanWord);
          }
        }
      }

      wordsLearned = newWords.size;

      return {
        success: true,
        message: `Training complete! Learned ${mathProblemsLearned} math problems, ${qaPairsLearned} Q&A pairs, ${phrasesLearned} phrases, ${sentencesLearned} sentences, and ${wordsLearned} new words.`,
        phrasesLearned,
        sentencesLearned,
        wordsLearned,
        qaPairsLearned,
        mathProblemsLearned
      };
    }

    function findLearnedPhrase(input) {
      const lowerInput = input.toLowerCase().trim();
      
      // PRIORITY 1: Check for question-answer pairs
      const storedQAPairs = memoryData.filter(m => m.category === 'qa_pair');
      for (const qaData of storedQAPairs) {
        try {
          const qa = JSON.parse(qaData.value);
          if (lowerInput.includes(qa.question) || qa.question.includes(lowerInput)) {
            return qa.answer;
          }
        } catch (e) {
          // Skip invalid JSON
        }
      }

      for (const qa of questionAnswerPairs) {
        if (lowerInput.includes(qa.question) || qa.question.includes(lowerInput)) {
          return qa.answer;
        }
      }

      // Fuzzy match for Q&A pairs
      const inputWords = lowerInput.split(/\s+/).map(w => w.replace(/[^a-z0-9]/gi, ''));
      let bestQAMatch = null;
      let highestQAScore = 0;

      for (const qaData of storedQAPairs) {
        try {
          const qa = JSON.parse(qaData.value);
          const questionWords = qa.question.split(/\s+/);
          let matchCount = 0;
          
          for (const word of inputWords) {
            if (word.length > 2 && questionWords.includes(word)) {
              matchCount++;
            }
          }

          const score = matchCount / Math.max(inputWords.length, questionWords.length);
          if (score > highestQAScore && score > 0.5) {
            highestQAScore = score;
            bestQAMatch = qa.answer;
          }
        } catch (e) {
          // Skip invalid JSON
        }
      }

      for (const qa of questionAnswerPairs) {
        const questionWords = qa.question.split(/\s+/);
        let matchCount = 0;
        
        for (const word of inputWords) {
          if (word.length > 2 && questionWords.includes(word)) {
            matchCount++;
          }
        }

        const score = matchCount / Math.max(inputWords.length, questionWords.length);
        if (score > highestQAScore && score > 0.5) {
          highestQAScore = score;
          bestQAMatch = qa.answer;
        }
      }

      if (bestQAMatch) {
        return bestQAMatch;
      }

      // PRIORITY 2: Check for exact phrase meanings
      for (const learned of learnedPhrases) {
        if (lowerInput.includes(learned.phrase)) {
          return learned.meaning;
        }
      }

      const storedPhrases = memoryData.filter(m => m.category === 'phrase');
      for (const phrase of storedPhrases) {
        if (lowerInput.includes(phrase.key.toLowerCase())) {
          return phrase.value;
        }
      }

      // PRIORITY 3: Check if input words match learned sentences
      let bestMatch = null;
      let highestScore = 0;

      for (const sentence of learnedSentences) {
        const sentenceWords = sentence.split(/\s+/);
        let matchCount = 0;
        
        for (const word of inputWords) {
          if (word.length > 2 && sentenceWords.includes(word)) {
            matchCount++;
          }
        }

        const score = matchCount / Math.max(inputWords.length, sentenceWords.length);
        if (score > highestScore && score > 0.4) {
          highestScore = score;
          bestMatch = sentence;
        }
      }

      const storedSentences = memoryData.filter(m => m.category === 'sentence');
      for (const sentenceData of storedSentences) {
        const sentence = sentenceData.value.toLowerCase();
        const sentenceWords = sentence.split(/\s+/);
        let matchCount = 0;
        
        for (const word of inputWords) {
          if (word.length > 2 && sentenceWords.includes(word)) {
            matchCount++;
          }
        }

        const score = matchCount / Math.max(inputWords.length, sentenceWords.length);
        if (score > highestScore && score > 0.4) {
          highestScore = score;
          bestMatch = sentence;
        }
      }

      if (bestMatch) {
        return `I recall learning: "${bestMatch}"`;
      }

      // PRIORITY 4: Check if input contains learned words
      const knownWords = inputWords.filter(word => 
        word.length > 2 && learnedWords.has(word)
      );

      if (knownWords.length > 0) {
        return `I recognize these words: ${knownWords.join(', ')}. I learned them during training.`;
      }

      return null;
    }

