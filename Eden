<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eden Ultimate AI - 5 Levels of Intelligence</title>
  <script src="/_sdk/data_sdk.js"></script>
  <script src="/_sdk/element_sdk.js"></script>
  <style>
    body {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', 'Rajdhani', sans-serif;
      background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 50%, #0a0e27 100%);
      color: #00ffea;
      height: 100%;
      overflow: hidden;
      position: relative;
    }

    html {
      height: 100%;
    }

    /* Animated holographic grid background */
    .holo-grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        repeating-linear-gradient(0deg, rgba(0, 255, 234, 0.08) 0px, transparent 1px, transparent 40px),
        repeating-linear-gradient(90deg, rgba(0, 255, 234, 0.08) 0px, transparent 1px, transparent 40px);
      background-size: 40px 40px;
      animation: gridFlow 20s linear infinite;
      pointer-events: none;
      opacity: 0.6;
    }

    @keyframes gridFlow {
      0% { transform: perspective(800px) rotateX(60deg) translateY(0) translateZ(0); }
      100% { transform: perspective(800px) rotateX(60deg) translateY(40px) translateZ(0); }
    }

    /* Floating particles */
    .particles {
      position: absolute;
      width: 100%;
      height: 100%;
      overflow: hidden;
      pointer-events: none;
    }

    .particle {
      position: absolute;
      width: 3px;
      height: 3px;
      background: #00ffea;
      border-radius: 50%;
      box-shadow: 0 0 10px #00ffea;
      animation: float 15s infinite ease-in-out;
      opacity: 0.6;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0) translateX(0); opacity: 0; }
      10% { opacity: 0.6; }
      90% { opacity: 0.6; }
      100% { transform: translateY(-100%) translateX(50px); opacity: 0; }
    }

    .ai-container {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      padding: 20px;
      padding-left: 40px;
      padding-top: 60px;
      z-index: 1;
    }

    /* Holographic AI head with multiple layers */
    .holo-head-container {
      position: relative;
      width: 180px;
      height: 180px;
      margin-bottom: 25px;
    }

    .holo-head {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 130px;
      height: 130px;
      background: radial-gradient(circle, rgba(0, 255, 234, 0.2), rgba(0, 255, 234, 0.05));
      border: 3px solid #00ffea;
      border-radius: 50%;
      box-shadow: 
        0 0 40px rgba(0, 255, 234, 0.6),
        0 0 80px rgba(0, 255, 234, 0.4) inset,
        0 0 120px rgba(0, 255, 234, 0.2);
      animation: headPulse 3s infinite ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 50px;
    }

    .holo-head.speaking {
      animation: headPulse 0.5s infinite ease-in-out, speakGlow 0.3s infinite;
    }

    .holo-head.thinking {
      animation: headPulse 1.5s infinite ease-in-out, thinkGlow 2s infinite;
    }

    .holo-head.learning {
      animation: headPulse 1s infinite ease-in-out, learnGlow 1.5s infinite;
    }

    @keyframes headPulse {
      0%, 100% { 
        transform: translate(-50%, -50%) scale(1);
        box-shadow: 0 0 40px rgba(0, 255, 234, 0.6), 0 0 80px rgba(0, 255, 234, 0.4) inset;
      }
      50% { 
        transform: translate(-50%, -50%) scale(1.08);
        box-shadow: 0 0 60px rgba(0, 255, 234, 0.9), 0 0 120px rgba(0, 255, 234, 0.6) inset;
      }
    }

    @keyframes speakGlow {
      0%, 100% { box-shadow: 0 0 40px rgba(0, 255, 234, 0.8), 0 0 80px rgba(0, 255, 234, 0.5) inset; }
      50% { box-shadow: 0 0 80px rgba(0, 255, 234, 1), 0 0 140px rgba(0, 255, 234, 0.8) inset; }
    }

    @keyframes thinkGlow {
      0%, 100% { 
        border-color: #8a2be2;
        box-shadow: 0 0 40px rgba(138, 43, 226, 0.8), 0 0 80px rgba(138, 43, 226, 0.5) inset;
      }
      50% { 
        border-color: #9d4edd;
        box-shadow: 0 0 80px rgba(138, 43, 226, 1), 0 0 140px rgba(138, 43, 226, 0.8) inset;
      }
    }

    @keyframes learnGlow {
      0%, 100% { 
        border-color: #00ff88;
        box-shadow: 0 0 40px rgba(0, 255, 136, 0.8), 0 0 80px rgba(0, 255, 136, 0.5) inset;
      }
      50% { 
        border-color: #00ffaa;
        box-shadow: 0 0 80px rgba(0, 255, 136, 1), 0 0 140px rgba(0, 255, 136, 0.8) inset;
      }
    }

    /* Rotating rings around the head */
    .holo-ring {
      position: absolute;
      top: 50%;
      left: 50%;
      border: 2px solid rgba(0, 255, 234, 0.3);
      border-radius: 50%;
      transform-style: preserve-3d;
    }

    .ring-1 {
      width: 160px;
      height: 160px;
      transform: translate(-50%, -50%) rotateX(70deg);
      animation: rotateRing1 8s linear infinite;
    }

    .ring-2 {
      width: 180px;
      height: 180px;
      transform: translate(-50%, -50%) rotateX(70deg);
      animation: rotateRing2 12s linear infinite reverse;
      border-color: rgba(0, 255, 234, 0.2);
    }

    @keyframes rotateRing1 {
      from { transform: translate(-50%, -50%) rotateX(70deg) rotateZ(0deg); }
      to { transform: translate(-50%, -50%) rotateX(70deg) rotateZ(360deg); }
    }

    @keyframes rotateRing2 {
      from { transform: translate(-50%, -50%) rotateX(70deg) rotateZ(0deg); }
      to { transform: translate(-50%, -50%) rotateX(70deg) rotateZ(360deg); }
    }

    /* Holographic panel for text */
    .holo-panel {
      position: relative;
      max-width: 50%;
      min-height: 100px;
      background: linear-gradient(135deg, rgba(0, 20, 40, 0.7), rgba(0, 10, 30, 0.8));
      padding: 20px 30px;
      border-radius: 20px;
      border: 2px solid #00ffea;
      box-shadow: 
        0 0 30px rgba(0, 255, 234, 0.4),
        inset 0 0 30px rgba(0, 255, 234, 0.1);
      margin-bottom: 25px;
      backdrop-filter: blur(10px);
      overflow: hidden;
    }

    .holo-panel::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(45deg, transparent, rgba(0, 255, 234, 0.1), transparent);
      animation: panelShine 4s infinite;
    }

    @keyframes panelShine {
      0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
      100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
    }

    .ai-text {
      position: relative;
      font-size: 18px;
      text-align: left;
      color: #00ffea;
      line-height: 1.6;
      text-shadow: 0 0 15px rgba(0, 255, 234, 0.6);
      letter-spacing: 0.5px;
      z-index: 1;
      min-height: 50px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    /* Chat history */
    .chat-history {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 350px;
      max-height: 80%;
      background: linear-gradient(135deg, rgba(0, 20, 40, 0.6), rgba(0, 10, 30, 0.7));
      border: 1px solid rgba(0, 255, 234, 0.4);
      border-radius: 15px;
      padding: 15px;
      overflow-y: auto;
      box-shadow: 0 0 20px rgba(0, 255, 234, 0.3);
      backdrop-filter: blur(10px);
    }

    .self-learn-panel {
      background: linear-gradient(135deg, rgba(138, 43, 226, 0.15), rgba(157, 78, 221, 0.1));
      border: 1px solid rgba(138, 43, 226, 0.5);
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 15px;
    }

    .self-learn-title {
      font-size: 11px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 10px;
      color: #9d4edd;
      text-align: center;
    }

    .self-learn-item {
      font-size: 11px;
      line-height: 1.5;
      padding: 8px;
      margin-bottom: 8px;
      background: rgba(138, 43, 226, 0.1);
      border-left: 2px solid #8a2be2;
      border-radius: 5px;
      animation: selfLearnSlide 0.4s ease-out;
    }

    @keyframes selfLearnSlide {
      from { opacity: 0; transform: translateX(20px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .self-learn-label {
      font-size: 9px;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 3px;
      color: #9d4edd;
    }

    .chat-history::-webkit-scrollbar {
      width: 6px;
    }

    .chat-history::-webkit-scrollbar-track {
      background: rgba(0, 20, 40, 0.5);
      border-radius: 10px;
    }

    .chat-history::-webkit-scrollbar-thumb {
      background: #00ffea;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 255, 234, 0.5);
    }

    .chat-message {
      margin-bottom: 12px;
      padding: 10px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.5;
      animation: messageSlide 0.3s ease-out;
    }

    @keyframes messageSlide {
      from { opacity: 0; transform: translateX(20px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .chat-message.user {
      background: rgba(0, 255, 234, 0.15);
      border-left: 3px solid #00ffea;
      text-align: right;
    }

    .chat-message.eden {
      background: rgba(0, 150, 255, 0.15);
      border-left: 3px solid #0096ff;
    }

    .message-label {
      font-size: 10px;
      opacity: 0.7;
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* Control buttons */
    .controls {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 20px;
    }

    .button {
      padding: 16px 35px;
      font-size: 18px;
      font-weight: 600;
      border: 2px solid #00ffea;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(0, 255, 234, 0.1), rgba(0, 150, 255, 0.15));
      color: #00ffea;
      cursor: pointer;
      box-shadow: 0 0 25px rgba(0, 255, 234, 0.4);
      transition: all 0.3s ease;
      text-transform: uppercase;
      letter-spacing: 2px;
      position: relative;
      overflow: hidden;
    }

    .button::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(0, 255, 234, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .button:hover::before {
      width: 400px;
      height: 400px;
    }

    .button:hover {
      background: rgba(0, 255, 234, 0.3);
      box-shadow: 0 0 45px rgba(0, 255, 234, 0.8);
      transform: translateY(-3px);
    }

    .button:active {
      transform: translateY(-1px);
    }

    .button:disabled {
      opacity: 0.3;
      cursor: not-allowed;
      transform: none;
    }

    .button.listening {
      background: linear-gradient(135deg, rgba(255, 0, 102, 0.3), rgba(255, 51, 102, 0.4));
      border-color: #ff0066;
      box-shadow: 0 0 25px rgba(255, 0, 102, 0.6);
      animation: listenPulse 1s ease-in-out infinite;
    }

    @keyframes listenPulse {
      0%, 100% { box-shadow: 0 0 25px rgba(255, 0, 102, 0.6); }
      50% { box-shadow: 0 0 45px rgba(255, 0, 102, 1); }
    }

    /* Input field */
    .input-container {
      display: flex;
      gap: 15px;
      max-width: 450px;
      width: 50%;
      margin-bottom: 15px;
    }

    #textInput {
      flex: 1;
      padding: 16px 24px;
      background: linear-gradient(135deg, rgba(0, 20, 40, 0.7), rgba(0, 10, 30, 0.8));
      border: 2px solid #00ffea;
      border-radius: 12px;
      color: #00ffea;
      font-size: 16px;
      font-family: inherit;
      outline: none;
      transition: all 0.3s ease;
      box-shadow: 0 0 20px rgba(0, 255, 234, 0.3);
    }

    #textInput:focus {
      box-shadow: 0 0 35px rgba(0, 255, 234, 0.6);
      border-color: #00ffea;
    }

    #textInput::placeholder {
      color: rgba(0, 255, 234, 0.5);
    }

    /* Status indicators */
    .status-bar {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      font-size: 14px;
      color: #00ffea;
      text-shadow: 0 0 10px rgba(0, 255, 234, 0.6);
    }

    .knowledge-indicator {
      font-size: 12px;
      opacity: 0.7;
      margin-top: 5px;
    }

    /* Training Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      z-index: 1000;
      backdrop-filter: blur(10px);
    }

    .modal-content {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 90%;
      max-width: 700px;
      background: linear-gradient(135deg, rgba(0, 20, 40, 0.95), rgba(0, 10, 30, 0.95));
      border: 2px solid #00ffea;
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 0 50px rgba(0, 255, 234, 0.6);
    }

    .modal-title {
      text-align: center;
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 20px;
      color: #00ffea;
      text-shadow: 0 0 20px rgba(0, 255, 234, 0.8);
      letter-spacing: 2px;
    }

    .modal-description {
      font-size: 14px;
      margin-bottom: 20px;
      opacity: 0.8;
      text-align: center;
      line-height: 1.6;
    }

    textarea {
      width: 100%;
      height: 250px;
      background: rgba(0, 20, 40, 0.7);
      border: 2px solid #00ffea;
      border-radius: 12px;
      color: #00ffea;
      font-size: 15px;
      font-family: inherit;
      padding: 20px;
      resize: vertical;
      box-shadow: 0 0 20px rgba(0, 255, 234, 0.3) inset;
      line-height: 1.6;
    }

    textarea::placeholder {
      color: rgba(0, 255, 234, 0.5);
    }

    @media (max-width: 768px) {
      .holo-head-container {
        width: 180px;
        height: 180px;
      }

      .holo-head {
        width: 130px;
        height: 130px;
        font-size: 50px;
      }

      .ring-1 {
        width: 160px;
        height: 160px;
      }

      .ring-2 {
        width: 180px;
        height: 180px;
      }

      .ai-text {
        font-size: 18px;
      }

      .holo-panel {
        padding: 20px 25px;
        max-width: 90%;
      }

      .chat-history {
        width: 250px;
        max-height: 50%;
      }

      .button {
        padding: 12px 24px;
        font-size: 14px;
      }

      .input-container {
        width: 90%;
      }
    }
  </style>
