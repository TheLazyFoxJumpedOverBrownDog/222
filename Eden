    async function processInput(input) {
      if (!input.trim()) return;

      displayMainText(input, 'user');
      addToContext('user', input);
      
      // LEVEL 5: SENTIMENT ANALYSIS
      const sentiment = analyzeSentiment(input);
      if (sentiment.response) {
        addChatMessage('eden', `💭 [Detected sentiment: ${sentiment.sentiment}]`);
      }
      
      const thinkingMsg = toneVariations.thinking[Math.floor(Math.random() * toneVariations.thinking.length)];
      setStatus(thinkingMsg.toUpperCase());

      if (requiresThinking(input)) {
        document.getElementById('holoHead').classList.add('thinking');
        
        // Show multi-step reasoning
        addChatMessage('eden', `Step 1: Understanding - The user said: "${input}"`);
        await new Promise(resolve => setTimeout(resolve, 500));
        addChatMessage('eden', `Step 2: Analyzing - Breaking down the key concepts...`);
        await new Promise(resolve => setTimeout(resolve, 500));
        addChatMessage('eden', `Step 3: Recalling - Searching knowledge base...`);
        await new Promise(resolve => setTimeout(resolve, 500));
        
        const thinkingResult = solveWithThinking(input);
        
        if (thinkingResult) {
          addChatMessage('eden', `Step 4: Synthesizing - Combining information...`);
          await new Promise(resolve => setTimeout(resolve, 500));
          displayMainText(thinkingResult);
          addToContext('eden', thinkingResult);
          document.getElementById('holoHead').classList.remove('thinking');
          speakText(thinkingResult);
          setStatus('COMPUTATION COMPLETE');
          return;
        }
        
        document.getElementById('holoHead').classList.remove('thinking');
      }

      const teaching = parseTeachingInput(input);
      
      if (teaching.isTeaching) {
        // LEVEL 3: Check for contradictions
        const contradiction = detectContradiction(teaching.value, teaching.category);
        
        if (contradiction.hasContradiction) {
          displayMainText(contradiction.message);
          addToContext('eden', contradiction.message);
          speakText(contradiction.message);
          setStatus('CONTRADICTION DETECTED');
          return;
        }
        
        const success = await storeMemory(teaching.category, teaching.category, teaching.value);
        if (success) {
          const learningMsg = toneVariations.learning[Math.floor(Math.random() * toneVariations.learning.length)];
          const response = `${learningMsg} Recorded: ${teaching.category} = ${teaching.value}`;
          displayMainText(response);
          addToContext('eden', response);
          speakText(response);
          setStatus('MEMORY UPDATED');
        }
        return;
      }

      // LEVEL 5: Check for inter-topic links
      const topicLinks = findTopicLinks(input);
      if (topicLinks.length > 0) {
        const linkedResponse = topicLinks[0];
        displayMainText(linkedResponse);
        addToContext('eden', linkedResponse);
        speakText(linkedResponse);
        setStatus('KNOWLEDGE LINKED');
        return;
      }

      const learnedResponse = findLearnedPhrase(input);
      if (learnedResponse) {
        // Self-reflect on response quality
        const reflection = selfReflect(learnedResponse, input);
        addChatMessage('eden', `[Self-reflection: ${reflection.feedback}]`);
        
        if (reflection.shouldKeep) {
          displayMainText(learnedResponse);
          addToContext('eden', learnedResponse);
          speakText(learnedResponse);
          setStatus('PHRASE RECOGNIZED');
        } else {
          const improvedResponse = `${learnedResponse} (I'm still learning to improve this answer)`;
          displayMainText(improvedResponse);
          addToContext('eden', improvedResponse);
          speakText(improvedResponse);
          setStatus('LEARNING TO IMPROVE');
        }
        return;
      }

      // LEVEL 5: Respond to sentiment
      if (sentiment.response) {
        displayMainText(sentiment.response);
        addToContext('eden', sentiment.response);
        speakText(sentiment.response);
        setStatus('EMOTIONAL RESPONSE');
        return;
      }

      const conversationalResponse = generateConversationalResponse(input);
      if (conversationalResponse) {
        displayMainText(conversationalResponse);
        addToContext('eden', conversationalResponse);
        speakText(conversationalResponse);
        setStatus('RESPONSE DELIVERED');
        return;
      }

      const memoryResponse = searchMemory(input);
      
      if (memoryResponse) {
        const ackMsg = toneVariations.acknowledgment[Math.floor(Math.random() * toneVariations.acknowledgment.length)];
        addChatMessage('eden', ackMsg);
        displayMainText(memoryResponse);
        addToContext('eden', memoryResponse);
        speakText(memoryResponse);
        setStatus('KNOWLEDGE RETRIEVED');
      } else {
        // LEVEL 2: Check recent context
        const recentContext = getRecentContext(3);
        if (recentContext.length > 1) {
          const contextHint = `Based on our recent conversation, I remember we discussed: "${recentContext[recentContext.length - 2].message}". `;
          const uncertainMsg = toneVariations.uncertainty[Math.floor(Math.random() * toneVariations.uncertainty.length)];
          const fallbackResponse = `${contextHint}${uncertainMsg} Use the TRAIN button to teach me more.`;
          displayMainText(fallbackResponse);
          addToContext('eden', fallbackResponse);
          speakText(fallbackResponse);
          setStatus('CONTEXT AWARE');
        } else {
          const uncertainMsg = toneVariations.uncertainty[Math.floor(Math.random() * toneVariations.uncertainty.length)];
          const fallbackResponse = `${uncertainMsg} Use the TRAIN button to teach me new phrases and words.`;
          displayMainText(fallbackResponse);
          addToContext('eden', fallbackResponse);
          speakText(fallbackResponse);
          setStatus('AWAITING INPUT');
        }
      }
    }

    function speakText(text) {
      if (synthesis.speaking) {
        synthesis.cancel();
      }

      const cleanText = text.replace(/<[^>]*>/g, '');
      const utterance = new SpeechSynthesisUtterance(cleanText);
      
      const voices = synthesis.getVoices();
      const preferredVoice = voices.find(voice => 
        voice.name.includes('Google UK English Male') || 
        voice.name.includes('Microsoft David') ||
        (voice.lang.startsWith('en') && voice.name.toLowerCase().includes('male'))
      ) || voices.find(voice => voice.lang.startsWith('en'));
      
      if (preferredVoice) {
        utterance.voice = preferredVoice;
      }
      
      utterance.rate = 0.95;
      utterance.pitch = 0.9;
      utterance.volume = 1.0;

      utterance.onstart = () => {
        document.getElementById('holoHead').classList.add('speaking');
      };

      utterance.onend = () => {
        document.getElementById('holoHead').classList.remove('speaking');
      };

      synthesis.speak(utterance);
    }

    document.getElementById('sendBtn').addEventListener('click', () => {
      const input = document.getElementById('textInput').value;
      if (input.trim()) {
        processInput(input);
        document.getElementById('textInput').value = '';
      }
    });

    document.getElementById('textInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        const input = document.getElementById('textInput').value;
        if (input.trim()) {
          processInput(input);
          document.getElementById('textInput').value = '';
        }
      }
    });

    document.getElementById('trainBtn').addEventListener('click', () => {
      document.getElementById('trainingModal').style.display = 'block';
      document.getElementById('trainingText').value = '';
      document.getElementById('trainingStatus').textContent = '';
    });

    document.getElementById('closeTrainingBtn').addEventListener('click', () => {
      document.getElementById('trainingModal').style.display = 'none';
    });

    document.getElementById('processTrainingBtn').addEventListener('click', async () => {
      const trainingText = document.getElementById('trainingText').value;
      const statusEl = document.getElementById('trainingStatus');
      const processBtn = document.getElementById('processTrainingBtn');
      
      if (!trainingText.trim()) {
        statusEl.textContent = '⚠️ Please enter training data';
        statusEl.style.color = '#ff6b6b';
        return;
      }

      processBtn.disabled = true;
      statusEl.textContent = '⏳ Processing training data...';
      statusEl.style.color = '#00ffea';

      const result = await processTrainingData(trainingText);

      if (result.success) {
        statusEl.textContent = `✅ ${result.message}`;
        statusEl.style.color = '#00ff88';
        
        setTimeout(() => {
          document.getElementById('trainingModal').style.display = 'none';
          displayMainText(`Training complete! I learned ${result.mathProblemsLearned} math problems, ${result.qaPairsLearned} Q&A pairs, ${result.phrasesLearned} phrases, ${result.sentencesLearned} sentences, and ${result.wordsLearned} new words. Total vocabulary: ${learnedWords.size} words.`);
          setStatus('TRAINING COMPLETE');
          updateKnowledgeIndicator();
        }, 2000);
      } else {
        statusEl.textContent = `❌ ${result.message}`;
        statusEl.style.color = '#ff6b6b';
      }

      processBtn.disabled = false;
    });

    document.getElementById('speakBtn').addEventListener('click', () => {
      const text = document.getElementById('aiText').textContent;
      if (text) {
        speakText(text);
      } else {
        setStatus('NO TEXT TO VOCALIZE');
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      const chatHistory = document.getElementById('chatHistory');
      chatHistory.innerHTML = '<div style="text-align: center; font-weight: bold; margin-bottom: 10px; font-size: 12px; letter-spacing: 1px;">CONVERSATION LOG</div>';
      const greetingMsg = window.elementSdk?.config?.greeting_message || defaultConfig.greeting_message;
      document.getElementById('aiText').textContent = greetingMsg;
      setStatus('CONVERSATION CLEARED');
    });

    document.getElementById('selfLearnBtn').addEventListener('click', () => {
      if (selfLearningActive) {
        stopSelfLearning();
      } else {
        startSelfLearning();
      }
    });

    if (synthesis.onvoiceschanged !== undefined) {
      synthesis.onvoiceschanged = () => {};
    }

    initializeApp();
  </script>
