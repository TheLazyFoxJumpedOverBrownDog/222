    function requiresThinking(input) {
      const lowerInput = input.toLowerCase();
      return lowerInput.match(/\d+\s*[\+\-\*\/×÷]\s*\d+/) || 
             lowerInput.match(/calculate|solve|compute|what is \d+/) ||
             lowerInput.match(/why|how does|explain|analyze/);
    }

    // LEVEL 5: COMPLEX PROBLEM SOLVING
    function solveComplexProblem(input) {
      const lowerInput = input.toLowerCase();
      
      // Multi-step word problems
      const applePattern = /(\d+)\s+red\s+apples?\s+and\s+(\d+)\s+green\s+apples?/i;
      const appleMatch = input.match(applePattern);
      
      if (appleMatch) {
        const redApples = parseInt(appleMatch[1]);
        const greenApples = parseInt(appleMatch[2]);
        const total = redApples + greenApples;
        
        return {
          steps: [
            `Step 1: Count red apples = ${redApples}`,
            `Step 2: Count green apples = ${greenApples}`,
            `Step 3: Add them together = ${redApples} + ${greenApples}`,
            `Step 4: Total = ${total}`
          ],
          answer: `You have ${total} apples in total.`
        };
      }
      
      // Subtraction word problems
      const eatPattern = /(?:have|had)\s+(\d+)\s+(\w+)\s+and\s+(?:eat|ate|lose|lost|give|gave)\s+(\d+)/i;
      const eatMatch = input.match(eatPattern);
      
      if (eatMatch) {
        const initial = parseInt(eatMatch[1]);
        const item = eatMatch[2];
        const removed = parseInt(eatMatch[3]);
        const remaining = initial - removed;
        
        return {
          steps: [
            `Step 1: Initial ${item} = ${initial}`,
            `Step 2: ${item} removed = ${removed}`,
            `Step 3: Calculate remaining = ${initial} - ${removed}`,
            `Step 4: Result = ${remaining}`
          ],
          answer: `You have ${remaining} ${item} left.`
        };
      }
      
      // Simple math operations
      const mathMatch = input.match(/(\d+)\s*([\+\-\*\/×÷])\s*(\d+)/);
      if (mathMatch) {
        const num1 = parseInt(mathMatch[1]);
        const operator = mathMatch[2];
        const num2 = parseInt(mathMatch[3]);
        
        let result;
        let operation;
        if (operator === '+') {
          result = num1 + num2;
          operation = 'addition';
        } else if (operator === '-') {
          result = num1 - num2;
          operation = 'subtraction';
        } else if (operator === '*' || operator === '×') {
          result = num1 * num2;
          operation = 'multiplication';
        } else if (operator === '/' || operator === '÷') {
          result = num1 / num2;
          operation = 'division';
        }
        
        return {
          steps: [
            `Step 1: Identify operation = ${operation}`,
            `Step 2: First number = ${num1}`,
            `Step 3: Second number = ${num2}`,
            `Step 4: Calculate = ${num1} ${operator} ${num2} = ${result}`
          ],
          answer: `The answer is ${result}.`
        };
      }
      
      return null;
    }

    function solveWithThinking(input) {
      const complexSolution = solveComplexProblem(input);
      
      if (complexSolution) {
        // Display each step
        for (const step of complexSolution.steps) {
          addChatMessage('eden', `🧠 ${step}`);
        }
        return complexSolution.answer;
      }
      
      return null;
    }

    function parseTeachingInput(input) {
      const lowerInput = input.toLowerCase().trim();
      
      const namePattern = /(?:call me|my name is|i'm|i am) ([a-zA-Z]+)/i;
      const nameMatch = input.match(namePattern);
      if (nameMatch) {
        return { category: 'name', value: nameMatch[1], isTeaching: true };
      }
      
      const favoritePattern = /my (?:favorite )?(\w+) is (.+)/i;
      const match = input.match(favoritePattern);
      if (match) {
        const category = match[1].toLowerCase();
        const value = match[2].trim();
        return { category, value, isTeaching: true };
      }
      
      const likePattern = /i (?:like|love|enjoy|prefer) (.+)/i;
      const likeMatch = input.match(likePattern);
      if (likeMatch) {
        const value = likeMatch[1].trim();
        return { category: 'preference', value, isTeaching: true };
      }
      
      return { isTeaching: false };
    }

    async function storeMemory(category, key, value) {
      if (memoryData.length >= 999) {
        setStatus("MEMORY CAPACITY REACHED");
        return false;
      }

      const existing = memoryData.find(m => m.category === category && m.key === key);
      
      if (existing) {
        existing.value = value;
        existing.timestamp = Date.now();
        const result = await window.dataSdk.update(existing);
        return result.isOk;
      } else {
        const result = await window.dataSdk.create({
          id: `mem_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
          type: 'personal',
          category,
          key,
          value,
          timestamp: Date.now()
        });
        return result.isOk;
      }
    }

    function searchMemory(query) {
      const lowerQuery = query.toLowerCase();
      const userName = window.elementSdk?.config?.user_name || defaultConfig.user_name;
      
      // Check phrase meanings first
      for (const [phrase, meaning] of Object.entries(knowledgeBase.meanings)) {
        if (lowerQuery.includes(phrase)) {
          return `"${phrase}" means ${meaning}.`;
        }
      }
      
      if (lowerQuery.includes('my name') || lowerQuery.includes('who am i')) {
        return `Your name is ${userName}.`;
      }
      
      // Check for joke requests
      if (lowerQuery.match(/tell.*joke|joke|funny/)) {
        const randomJoke = knowledgeBase.jokes[Math.floor(Math.random() * knowledgeBase.jokes.length)];
        return randomJoke;
      }
      
      const myPattern = /what(?:'s| is) my (\w+)/i;
      const myMatch = lowerQuery.match(myPattern);
      
      if (myMatch) {
        const category = myMatch[1].toLowerCase();
        const memory = memoryData.find(m => m.category === category);
        if (memory) {
          return `Your ${category} is ${memory.value}.`;
        }
      }
      
      for (const mem of memoryData) {
        if (lowerQuery.includes(mem.category.toLowerCase()) || 
            lowerQuery.includes(mem.value.toLowerCase())) {
          return `Memory recall: Your ${mem.category} is ${mem.value}.`;
        }
      }
      
      const keywords = lowerQuery.split(' ').filter(word => word.length > 3);
      
      // Search all knowledge categories
      const allFacts = [
        ...knowledgeBase.general_facts,
        ...knowledgeBase.math,
        ...knowledgeBase.sentences
      ];
      
      for (const fact of allFacts) {
        const factLower = fact.toLowerCase();
        let matchCount = 0;
        
        for (const keyword of keywords) {
          if (factLower.includes(keyword)) {
            matchCount++;
          }
        }
        
        if (matchCount >= 2 || (keywords.length === 1 && matchCount === 1)) {
          return fact;
        }
      }
      
      return null;
    }

