          questionAnswerPairs.push({ question: question.toLowerCase(), answer: answer });
          generatedContent = `<strong>Q:</strong> ${question}<br><strong>A:</strong> ${answer}`;
          contentType = 'Q&A Generation';
        }

      } else if (learningMode === 1) {
        // MODE 2: Generate paraphrased sentences
        const randomKnowledge = allKnowledge[Math.floor(Math.random() * allKnowledge.length)];
        const paraphrasedSentence = `I understand that ${randomKnowledge.key} relates to ${randomKnowledge.value}`;

        const sentenceKey = `sentence_self_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;
