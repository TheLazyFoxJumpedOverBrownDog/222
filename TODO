let keysPressed = {};

document.addEventListener('keydown', (event) => {
  keysPressed[event.key.toLowerCase()] = true;
  if (keysPressed['z'] && keysPressed['k'] && keysPressed['r']) {
    const panel = document.getElementById('adminPanel');
    panel.classList.toggle('hidden');
    alert('🔐 Panel ZKR desbloqueado');
  }
});

document.addEventListener('keyup', (event) => {
  delete keysPressed[event.key.toLowerCase()];
});

// Activador manual de eventos
function activateEvent(eventType) {
  const status = document.getElementById("eventStatus");

  switch(eventType) {
    case 'nemesis':
      document.body.style.backgroundColor = "#1a0000";
      document.body.style.color = "#ff0000";
      status.textContent = "Evento actual: Nemesis Protocol";
      alert("⚠️ Evento 'Nemesis Protocol' activado.");
      break;

    case 'glitch':
      document.body.classList.add("glitch-mode");
      status.textContent = "Evento actual: Glitch Wave";
      alert("💀 Evento 'Glitch Wave' activado.");
      break;

    case 'awakening':
      document.title = "███ ALERTA ██";
      document.body.style.backgroundColor = "#000";
      status.textContent = "Evento actual: Reawakening 001";
      alert("🌀 Evento 'Reawakening 001' activado.");
      break;
  }
}<!-- Panel secreto (invisible al principio) -->
