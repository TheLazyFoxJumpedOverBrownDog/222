// Activación automática cada cierto tiempo o fecha
function activateRandomEvent() {
  const now = new Date();
  if (now.getDate() === 1) { // Cada 1° del mes
    const event = events[Math.floor(Math.random() * events.length)];
    event.effect();
  }
}

// Ejecutar al cargar la página
window.onload = activateRandomEvent;<div id="terminal">
