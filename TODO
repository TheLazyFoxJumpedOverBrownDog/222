<script src="zkrData.js"></script>// Lista base de ZKR conocidos
let zkrList = [
  { id: "ZKR-001", nombre: "Abdorvio", nivel: "Ω", descripcion: "Absorbió todos los registros anteriores." },
  { id: "ZKR-002", nombre: "Nemesis", nivel: "A", descripcion: "Entidad vinculada al protocolo perdido." },
  { id: "ZKR-003", nombre: "Run 13", nivel: "B", descripcion: "Entidad detectada cerca del Sector Run." }
];

// Función para generar nuevos ZKR aleatorios
function generarNuevoZKR() {
  const letras = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const num = Math.floor(Math.random() * 900 + 100);
  const letra = letras[Math.floor(Math.random() * letras.length)];
  const niveles = ["C", "B", "A", "S", "Ω"];
  const nivel = niveles[Math.floor(Math.random() * niveles.length)];

  const nuevoZKR = {
    id: `ZKR-${num}${letra}`,
    nombre: `Entidad ${letra}${num}`,
    nivel: nivel,
    descripcion: `Registro detectado automáticamente en ${new Date().toLocaleDateString()}.`
  };

  zkrList.push(nuevoZKR);
  return nuevoZKR;
}

// Guardar nuevos ZKR en localStorage
function guardarZKR() {
  localStorage.setItem("ZKR_Data", JSON.stringify(zkrList));
}

// Cargar los ZKR guardados
function cargarZKR() {
  const data = localStorage.getItem("ZKR_Data");
  if (data) zkrList = JSON.parse(data);
}

// Actualizar visualmente el catálogo
function actualizarCatalogo() {
  const contenedor = document.getElementById("catalogoZKR");
  contenedor.innerHTML = "";
  zkrList.forEach(zkr => {
    const card = document.createElement("div");
    card.className = "zkr-card";
    card.innerHTML = `
      <h3>${zkr.id}</h3>
      <p><strong>Nombre:</strong> ${zkr.nombre}</p>
      <p><strong>Nivel:</strong> ${zkr.nivel}</p>
      <p>${zkr.descripcion}</p>
    `;
    contenedor.appendChild(card);
  });
}

// Sistema de actualización automática
function checkForUpdates() {
  cargarZKR();

  const lastUpdate = localStorage.getItem("ZKR_LastUpdate");
  const now = Date.now();
  const week = 1000 * 60 * 60 * 24 * 7; // una semana

  if (!lastUpdate || now - lastUpdate > week) {
    const nuevo = generarNuevoZKR();
    guardarZKR();
    localStorage.setItem("ZKR_LastUpdate", now);
    alert(`🧬 Nuevo registro detectado: ${nuevo.id}`);
  }

  actualizarCatalogo();
}

