let eventos = [];

function generarNuevoZKR() {
  const letras = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const num = Math.floor(Math.random() * 900 + 100);
  const letra = letras[Math.floor(Math.random() * letras.length)];
  const niveles = ["C", "B", "A", "S", "Ω"];
  const nivel = niveles[Math.floor(Math.random() * niveles.length)];

  const nuevoZKR = {
    id: `ZKR-${num}${letra}`,
    nombre: `Entidad ${letra}${num}`,
    nivel: nivel,
    descripcion: `Registro detectado automáticamente en ${new Date().toLocaleDateString()}.`
  };

  zkrList.push(nuevoZKR);
  reproducirEfecto("Nuevo ZKR detectado");
  guardarZKR();
  actualizarCatalogo();
}

function reproducirEfecto(msg) {
  const alertSound = document.getElementById("alertSound");
  const glitchSound = document.getElementById("glitchSound");
  glitchSound.play();

  const overlay = document.createElement("div");
  overlay.className = "flicker";
  overlay.style.position = "fixed";
  overlay.style.top = 0;
  overlay.style.left = 0;
  overlay.style.width = "100%";
  overlay.style.height = "100%";
  overlay.style.background = "rgba(0,255,255,0.1)";
  overlay.style.zIndex = 9999;
  document.body.appendChild(overlay);

  setTimeout(() => {
    document.body.removeChild(overlay);
    alertSound.play();
    alert(`⚠️ ${msg}`);
  }, 2000);
}

function guardarZKR() {
  localStorage.setItem("ZKR_Data", JSON.stringify(zkrList));
}

function cargarZKR() {
  const data = localStorage.getItem("ZKR_Data");
  if (data) zkrList = JSON.parse(data);
}

function actualizarCatalogo() {
  const cont = document.getElementById("catalogoZKR");
  cont.innerHTML = "";
  zkrList.forEach(zkr => {
    const card = document.createElement("div");
    card.className = "zkr-card";
    card.innerHTML = `
      <h3>${zkr.id}</h3>
      <p><strong>${zkr.nombre}</strong></p>
      <p>Nivel: ${zkr.nivel}</p>
      <p>${zkr.descripcion}</p>
    `;
    cont.appendChild(card);
  });
}

function activarEvento() {
  const eventosPosibles = [
    "Eclipse del Sector Run",
    "Anomalía en el Catálogo 2",
    "ZKR-001 reactivado",
    "Fallo total de conexión"
  ];

  const e = {
    titulo: eventosPosibles[Math.floor(Math.random() * eventosPosibles.length)],
    fecha: new Date().toLocaleString(),
    efecto: "glitch"
  };
  eventos.push(e);
  actualizarEventos();
  reproducirEfecto(`Evento activado: ${e.titulo}`);
}

function actualizarEventos() {
  const cont = document.getElementById("catalogoEventos");
  cont.innerHTML = "";
  eventos.forEach(ev => {
    const div = document.createElement("div");
    div.className = "zkr-card";
    div.innerHTML = `<h3>${ev.titulo}</h3><p>${ev.fecha}</p>`;
    cont.appendChild(div);
  });
}

// Auto actualizador
function checkForUpdates() {
  cargarZKR();
  const last = localStorage.getItem("ZKR_LastUpdate");
  const now = Date.now();
  const day = 1000 * 60 * 60 * 24;

  if (!last || now - last > day) {
    generarNuevoZKR();
    localStorage.setItem("ZKR_LastUpdate", now);
  }
  actualizarCatalogo();
}

