<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Atlas Games Studio</title>
<link rel="manifest" href="manifest.json">
<style>
  body { margin:0; font-family: Arial, sans-serif; background: #111; color: #fff; display: flex; flex-direction: column; align-items: center; }
  header { padding:1rem; text-align:center; background: linear-gradient(to right, #1E3A8A, #1E40AF, #3B82F6); width:100%; font-size:1.5rem; font-weight:bold; }
  #editor { width:90%; max-width:800px; height:300px; margin:1rem 0; font-family: monospace; font-size:14px; background: #222 url('carbonfiber.png'); background-size: cover; color:#0f0; padding:1rem; overflow-y: scroll; border-radius:8px; }
  #canvas { border:2px solid #0f0; border-radius:8px; background:#000; }
  button { background:#0f0; color:#000; border:none; padding:0.5rem 1rem; font-weight:bold; cursor:pointer; margin:0.5rem; border-radius:5px; }
  button:hover { background:#0c0; }
</style>
</head>
<body>
<header>Atlas Games Studio</header>
<textarea id="editor">// Voorbeeld: Beweegbare speler
function setup(api) {
  api.player = { x: api.canvasWidth/2, y: api.canvasHeight/2, w:30, h:30, speed:150};
}
function update(dt, api) {
  const p = api.player;
  if(api.input.left) p.x -= p.speed*dt;
  if(api.input.right) p.x += p.speed*dt;
  if(api.input.up) p.y -= p.speed*dt;
  if(api.input.down) p.y += p.speed*dt;
}
function draw(api) {
  api.clear();
  const p = api.player;
  api.fillStyle='blue';
  api.fillRect(p.x-p.w/2, p.y-p.h/2, p.w, p.h);
}</textarea>
<div>
  <button onclick="runCode()">Run</button>
</div>
<canvas id="canvas" width="600" height="400"></canvas>
<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
let game = {};
const api = {
  canvasWidth: canvas.width,
  canvasHeight: canvas.height,
  fillStyle:'white',
  beginPath:()=>ctx.beginPath(),
  arc:(x,y,r,s,e)=>ctx.arc(x,y,r,s,e),
  fill:()=>ctx.fill(),
  fillRect:(x,y,w,h)=>ctx.fillRect(x,y,w,h),
  clear:()=>ctx.clearRect(0,0,canvas.width,canvas.height),
  fillText:(text,x,y)=>ctx.fillText(text,x,y),
  input:{left:false,right:false,up:false,down:false}
};
document.addEventListener('keydown',e=>{
  if(e.key==='ArrowLeft') api.input.left=true;
  if(e.key==='ArrowRight') api.input.right=true;
  if(e.key==='ArrowUp') api.input.up=true;
  if(e.key==='ArrowDown') api.input.down=true;
});
document.addEventListener('keyup',e=>{
  if(e.key==='ArrowLeft') api.input.left=false;
  if(e.key==='ArrowRight') api.input.right=false;
  if(e.key==='ArrowUp') api.input.up=false;
  if(e.key==='ArrowDown') api.input.down=false;
});
let lastTime=0;
function runCode(){
  try{
    const code=document.getElementById('editor').value;
    eval(code);
    if(game.setup) game.setup(api);
    lastTime=performance.now();
    requestAnimationFrame(loop);
  }catch(e){alert('Fout in code: '+e);}
}
function loop(time){
  const dt=(time-lastTime)/1000;
  lastTime=time;
  if(game.update) game.update(dt,api);
  if(game.draw) game.draw(api);
  requestAnimationFrame(loop);
}
</script>
</body>
</html>

