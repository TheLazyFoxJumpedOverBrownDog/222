              fetch('/api/artist-stats?email='+encodeURIComponent(user.email)).then(r=>r.json()).then(setStats);
              fetch('/api/artist-songs?email='+encodeURIComponent(user.email)).then(r=>r.json()).then(d=>setSongs(d.songs));
            },[user.email]);

            const handleUpload = e => {
              e.preventDefault();
              if (!songFile) return;
              const formData = new FormData();
              formData.append('artist', user.email);
              formData.append('file', songFile);
